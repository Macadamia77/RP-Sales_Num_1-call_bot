# 이 파일을 .env 로 복사해 값을 채우세요. 비어 있으면 전부 무료 목업으로 동작합니다.

# ---- LLM (대화 판단) ----------------------------------------------
# rule   : 규칙 기반 (기본, 무료, 오프라인)
# ollama : 로컬 오픈소스 모델 (무료)  예) ollama pull qwen2.5:7b
# gemini : Google AI Studio 무료 등급 키
# claude : Anthropic API (유료)
LLM_PROVIDER=rule
LLM_TIMEOUT=6
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- TTS (봇 목소리) ----------------------------------------------
# mock       : 서버 합성 없음 → 브라우저 기본 한국어 음성 / Twilio <Say>
# edge       : edge-tts (무료, 한국어 기본 음성, 복제 불가)  pip install edge-tts
# elevenlabs : 본인 목소리 복제 (유료)
TTS_PROVIDER=mock
EDGE_TTS_VOICE=ko-KR-SunHiNeural
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- 전화 (Twilio, 선택) -------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_SAY_VOICE=Polly.Seoyeon
TWILIO_VALIDATE_SIGNATURE=1
# Twilio가 접속할 수 있는 외부 주소 (예: ngrok) 
PUBLIC_BASE_URL=

# ---- 발신 정책 -----------------------------------------------------
# 실제 발신은 이 목록의 번호로만 합니다 (쉼표 구분). 처음엔 본인 번호만 넣으세요.
CALL_ALLOWLIST=
CALL_HOURS=09-18
MAX_ATTEMPTS_PER_JOB=2
